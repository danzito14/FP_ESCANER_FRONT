{
  "name": "fp-escaner-front",
  "version": "0.2.7",
  "description": "SL Asistencias — estación de asistencias de escritorio (escáner facial local + panel)",
  "author": "SL Agrícola",
  "homepage": "https://sl-asistencias.slagricola.cloud",
  "main": "electron/main.cjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:FP_ESCANER_FRONT": "node dist/FP_ESCANER_FRONT/server/server.mjs",
    "build:web": "ng build --configuration mobile && node scripts/sync-mobile.mjs",
    "cap:sync": "npm run build:web && npx cap sync android",
    "cap:open": "npx cap open android",
    "build:electron": "ng build --configuration electron && node scripts/sync-electron.mjs",
    "electron:dev": "electron . --dev",
    "electron:start": "electron .",
    "dist:win": "npm run build:electron && electron-builder --win --publish never",
    "dist:linux": "npm run build:electron && electron-builder --linux --publish never",
    "postinstall": "patch-package"
  },
  "private": true,
  "build": {
    "appId": "cloud.slagricola.slasistencias.escritorio",
    "productName": "SL Asistencias",
    "copyright": "Copyright © 2026 SL Agrícola",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SL Asistencias",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "SL-Asistencias-Estacion-${version}-setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "SL Agrícola <soporte@slagricola.cloud>",
      "synopsis": "Estación de asistencias con reconocimiento facial",
      "artifactName": "SL-Asistencias-Estacion-${version}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libatspi2.0-0",
        "libsecret-1-0",
        "xdg-utils",
        "speech-dispatcher",
        "espeak-ng"
      ]
    }
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.14",
    "@bluehalo/ngx-leaflet": "^21.2.1",
    "@capacitor-community/camera-preview": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-mlkit/face-detection": "^8.1.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.4.0",
    "@types/express": "^5.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "^20.17.19",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
